---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  /** CSS object-position value applied to every thumbnail */
  objectPosition?: string;
}

const { images, objectPosition = 'center' } = Astro.props;

const fullUrls = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1600, format: 'webp', quality: 90 })),
);
---

<div class="gallery-root">
  <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      images.map((img, i) => (
        <button
          class="gallery-trigger group h-[350px] cursor-zoom-in overflow-hidden"
          type="button"
          data-index={String(i)}
          data-full={fullUrls[i].src}
          data-alt={img.alt}
          aria-label={`Open ${img.alt} in lightbox`}
        >
          <Image
            src={img.src}
            alt={img.alt}
            width={700}
            height={350}
            class="pointer-events-none h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            style={`object-position:${objectPosition}`}
            loading="lazy"
          />
        </button>
      ))
    }
  </div>

  <dialog class="gallery-dialog" aria-modal="true" aria-label="Image lightbox">
    <div class="gallery-backdrop flex h-full w-full items-center justify-center p-8">
      <button
        class="gallery-close absolute top-4 right-4 z-20 flex size-11 items-center justify-center rounded text-white/60 transition-colors hover:text-white"
        type="button"
        aria-label="Close lightbox"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button
        class="gallery-prev absolute top-1/2 left-4 z-20 flex size-12 -translate-y-1/2 items-center justify-center rounded text-white/60 transition-colors hover:text-white"
        type="button"
        aria-label="Previous image"
      >
        <svg
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="gallery-next absolute top-1/2 right-4 z-20 flex size-12 -translate-y-1/2 items-center justify-center rounded text-white/60 transition-colors hover:text-white"
        type="button"
        aria-label="Next image"
      >
        <svg
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <img
        class="gallery-lightbox-img max-h-[85vh] max-w-[85vw] object-contain shadow-2xl"
        alt=""
      />

      <p
        class="gallery-counter absolute bottom-5 left-1/2 -translate-x-1/2 font-sans text-sm text-white/50"
      >
      </p>
    </div>
  </dialog>
</div>

<style>
  .gallery-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    border: none;
    background: transparent;
    overflow: hidden;
  }
  .gallery-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  .gallery-backdrop {
    position: relative;
    background: rgba(0, 0, 0, 0.88);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery-root').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('.gallery-dialog')!;
    const triggers = root.querySelectorAll<HTMLButtonElement>('.gallery-trigger');
    const lightboxImg = dialog.querySelector<HTMLImageElement>('.gallery-lightbox-img')!;
    const counter = dialog.querySelector<HTMLElement>('.gallery-counter')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.gallery-close')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.gallery-prev')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.gallery-next')!;
    const backdrop = dialog.querySelector<HTMLElement>('.gallery-backdrop')!;

    const items = [...triggers].map((t) => ({ full: t.dataset.full!, alt: t.dataset.alt! }));
    let current = 0;

    function show(index: number) {
      current = (index + items.length) % items.length;
      lightboxImg.src = items[current].full;
      lightboxImg.alt = items[current].alt;
      counter.textContent = `${current + 1} / ${items.length}`;
    }

    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });

    closeBtn.addEventListener('click', () => dialog.close());
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));

    // Close when clicking the dark backdrop (not the image or buttons)
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
