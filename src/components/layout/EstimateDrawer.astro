---
import { site } from '../../config/site';
import { Icon } from 'astro-icon/components';

const formAction = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
const thankYouUrl = new URL('/thank-you/', site.url).href;

const services = [
  'Custom Walkways',
  'Paver Driveways',
  'Landscaping',
  'Outdoor Living Spaces',
  'Patios',
  'Retaining Walls',
  'Waterscapes',
];
---

<!-- Fixed "Free Estimate" tab on the right edge -->
<button
  type="button"
  id="estimate-tab"
  aria-controls="estimate-drawer"
  aria-expanded="false"
  class="bg-accent-500 hover:bg-accent-600 focus-visible:outline-brand-700 fixed top-1/2 right-0 z-50 flex h-[164px] w-10 -translate-y-1/2 cursor-pointer flex-col items-center justify-center gap-1 rounded-l-md shadow-[-4px_0_12px_rgba(0,0,0,0.25)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <Icon name="lucide:file-text" class="text-neutral-0/70 size-4" aria-hidden="true" />
  <span
    class="text-neutral-0 text-[13px] font-medium tracking-[2px] uppercase select-none"
    style="writing-mode:vertical-rl;transform:rotate(180deg)"
  >
    Free Estimate
  </span>
</button>

<!-- Backdrop -->
<div
  id="estimate-backdrop"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-[55] bg-neutral-900/60 opacity-0 transition-opacity duration-300"
>
</div>

<!-- Drawer panel -->
<div
  id="estimate-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="estimate-heading"
  aria-hidden="true"
  inert
  class="bg-surface-base fixed inset-y-0 right-0 z-[60] flex w-full max-w-[500px] translate-x-full flex-col overflow-y-auto shadow-2xl transition-transform duration-300 ease-in-out"
>
  <!-- Drawer header -->
  <div class="border-line-base flex shrink-0 items-start justify-between border-b px-6 py-5">
    <div>
      <p class="text-accent-500 text-[12px] font-medium tracking-[2px] uppercase">Get In Touch</p>
      <h2
        id="estimate-heading"
        class="font-heading text-brand-700 text-[30px] leading-tight font-medium"
      >
        Request a Free Estimate
      </h2>
    </div>
    <button
      type="button"
      id="estimate-close"
      aria-label="Close estimate form"
      class="text-ink-base mt-1 ml-4 flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-md transition-colors hover:bg-neutral-100 focus-visible:outline-2"
    >
      <Icon name="lucide:x" class="size-5" aria-hidden="true" />
    </button>
  </div>

  <!-- Drawer body -->
  <div class="flex-1 px-6 pt-6 pb-10">
    <p class="mb-6 text-[16px] leading-relaxed text-neutral-900/55">
      Fill out the form and Len will be in touch to schedule your complimentary on-site
      consultation.
    </p>

    {
      !formAction && (
        <p class="mb-5 rounded border border-amber-300 bg-amber-50 p-3 text-[14px] text-amber-900">
          Add a <code>formspreeId</code> to <code>src/config/site.ts</code> to activate this form.
        </p>
      )
    }

    <form
      method="POST"
      action={formAction || '#'}
      class="flex flex-col gap-5"
      name="estimate-drawer"
    >
      {formAction && <input type="hidden" name="_next" value={thankYouUrl} />}
      {
        formAction && (
          <input type="hidden" name="_subject" value={`Free estimate request — ${site.name}`} />
        )
      }
      <!-- Honeypot spam prevention -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1">
          <span class="text-[12px] font-medium tracking-wider text-neutral-900/40 uppercase"
            >Full Name *</span
          >
          <input
            type="text"
            name="name"
            placeholder="Your name"
            required
            autocomplete="name"
            class="focus:border-brand-700 border-b border-neutral-300 bg-transparent py-2 text-[16px] text-neutral-900 placeholder:text-neutral-400 focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-[12px] font-medium tracking-wider text-neutral-900/40 uppercase"
            >Phone Number</span
          >
          <input
            type="tel"
            name="phone"
            placeholder="(231) 555-0000"
            autocomplete="tel"
            class="focus:border-brand-700 border-b border-neutral-300 bg-transparent py-2 text-[16px] text-neutral-900 placeholder:text-neutral-400 focus:outline-none"
          />
        </label>
      </div>

      <label class="flex flex-col gap-1">
        <span class="text-[12px] font-medium tracking-wider text-neutral-900/40 uppercase"
          >Email Address *</span
        >
        <input
          type="email"
          name="email"
          placeholder="you@email.com"
          required
          autocomplete="email"
          class="focus:border-brand-700 border-b border-neutral-300 bg-transparent py-2 text-[16px] text-neutral-900 placeholder:text-neutral-400 focus:outline-none"
        />
      </label>

      <!-- Service checkboxes -->
      <fieldset class="flex flex-col gap-3">
        <legend class="text-[12px] font-medium tracking-wider text-neutral-900/40 uppercase">
          What services are you interested in?
        </legend>
        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            services.map((service) => (
              <label class="hover:border-brand-700/50 has-[:checked]:border-brand-700 has-[:checked]:bg-brand-700/5 flex cursor-pointer items-center gap-2.5 rounded border border-neutral-200 px-3 py-2.5 transition-colors hover:bg-neutral-50">
                <input
                  type="checkbox"
                  name="services"
                  value={service}
                  class="accent-brand-700 size-4 shrink-0"
                />
                <span class="text-[15px] text-neutral-800">{service}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="flex flex-col gap-1">
        <span class="text-[12px] font-medium tracking-wider text-neutral-900/40 uppercase"
          >Tell Us About Your Project *</span
        >
        <textarea
          name="message"
          rows="4"
          placeholder="Describe your project, location, and any specific ideas..."
          required
          class="focus:border-brand-700 resize-none border-b border-neutral-300 bg-transparent py-2 text-[16px] text-neutral-900 placeholder:text-neutral-400 focus:outline-none"
        ></textarea>
      </label>

      <button
        type="submit"
        class="bg-brand-700 text-neutral-0 hover:bg-brand-800 focus-visible:outline-accent-500 mt-2 inline-flex min-h-[52px] w-full cursor-pointer items-center justify-center rounded-none font-sans text-[18px] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Send My Request
      </button>
    </form>
  </div>
</div>

<script>
  const tab = document.querySelector<HTMLButtonElement>('#estimate-tab');
  const closeBtn = document.querySelector<HTMLButtonElement>('#estimate-close');
  const drawer = document.querySelector<HTMLElement>('#estimate-drawer');
  const backdrop = document.querySelector<HTMLElement>('#estimate-backdrop');

  if (tab && closeBtn && drawer && backdrop) {
    const getFocusable = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])',
        ),
      );

    const getOutside = () =>
      (Array.from(document.body.children) as HTMLElement[]).filter(
        (el) => el !== drawer && el !== backdrop,
      );

    const openDrawer = () => {
      drawer.removeAttribute('inert');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.classList.remove('translate-x-full');
      backdrop.classList.remove('pointer-events-none', 'opacity-0');
      backdrop.classList.add('pointer-events-auto', 'opacity-100');
      tab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      for (const el of getOutside()) el.setAttribute('inert', '');
      // Delay focus until after the CSS transition starts
      setTimeout(() => getFocusable()[0]?.focus(), 50);
    };

    const closeDrawer = () => {
      drawer.setAttribute('inert', '');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.classList.add('translate-x-full');
      backdrop.classList.add('pointer-events-none', 'opacity-0');
      backdrop.classList.remove('pointer-events-auto', 'opacity-100');
      tab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      for (const el of getOutside()) el.removeAttribute('inert');
      tab.focus();
    };

    tab.addEventListener('click', () => {
      tab.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer();
    });

    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Intercept all Free Estimate link clicks site-wide
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[href="#free-estimate"]');
      if (link) {
        e.preventDefault();
        openDrawer();
      }
    });

    // ESC closes the drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && tab.getAttribute('aria-expanded') === 'true') {
        closeDrawer();
        return;
      }
      // Focus trap
      if (e.key === 'Tab' && tab.getAttribute('aria-expanded') === 'true') {
        const items = getFocusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
