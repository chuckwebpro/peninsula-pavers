---
import '../styles/global.css';

import SEO from '../components/seo/SEO.astro';
import Schema, { type BreadcrumbEntry, type FaqEntry } from '../components/seo/Schema.astro';
import Analytics from '../components/analytics/Analytics.astro';
import CookieConsent from '../components/analytics/CookieConsent.astro';
import Header, { type HeaderSticky } from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import EstimateDrawer from '../components/layout/EstimateDrawer.astro';
import { site, hasAnalytics } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  titleExact?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  pageType?: 'home' | 'services' | 'service' | 'about';
  breadcrumbs?: BreadcrumbEntry[];
  faqs?: FaqEntry[];
  service?: {
    name: string;
    description?: string;
    serviceType?: string;
    subServices?: string[];
  };
  sticky?: HeaderSticky;
}

const { breadcrumbs, faqs, service, pageType, sticky = 'sticky', ...seo } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />

    <!-- Switches the nav from its CSS-only fallback to scripted control. Inline
         and early so the mega panel never flashes open during load. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO {...seo} />
    <Schema pageType={pageType} breadcrumbs={breadcrumbs} faqs={faqs} service={service} />
    {hasAnalytics && <Analytics />}

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="focus:bg-surface-base sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:px-4 focus:py-2 focus:shadow-md"
    >
      Skip to content
    </a>

    <Header sticky={sticky} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    <EstimateDrawer />
    {site.consent === 'banner' && <CookieConsent />}
  </body>
</html>
