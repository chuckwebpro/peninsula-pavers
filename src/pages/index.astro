---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import TestimonialsCarousel from '../components/blocks/TestimonialsCarousel.astro';
import { testimonials } from '../config/testimonials';

const services = [
  {
    label: 'Outdoor Living Spaces',
    href: '/services/outdoor-living-spaces/',
    image: '/images/backyard-hardscaping.webp',
  },
  {
    label: 'Custom Patios',
    href: '/services/patios/',
    image: '/images/custom-patio-construction.webp',
  },
  {
    label: 'Paver Driveways',
    href: '/services/driveways/',
    image: '/images/driveway-with-pavers.webp',
  },
  {
    label: 'Retaining Walls',
    href: '/services/retaining-walls/',
    image: '/images/retaining-wall-construction.jpg',
  },
  {
    label: 'Stone Walkways',
    href: '/services/walkways/',
    image: '/images/custom-stone-walkway.webp',
  },
  {
    label: 'Waterscapes',
    href: '/services/waterscapes/',
    image: '/images/frontyard-waterscape.jpg',
  },
];

const stats = [
  { value: '30+', label: 'Years In Business' },
  { value: '12', label: 'Counties Served' },
  { value: '100%', label: 'Satisfaction Guaranteed' },
  { value: '1994', label: 'Est. In Traverse City' },
];

const aboutBullets = [
  'BBB Accredited Business',
  'Natural Stone & Man-Made Materials',
  'Residential & Commercial',
  'Serving Northern Michigan Since 1994',
];
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  pageType="home"
  sticky="overlay"
>
  <link slot="head" rel="preload" as="image" href="/images/s1.webp" fetchpriority="high" />
  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section class="relative flex min-h-screen items-end pt-32 pb-16" aria-label="Hero">
    <div
      class="hero-bg bg-brand-900 absolute inset-0 bg-cover bg-center"
      style="background-image:url('/images/s1.webp')"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-bg hero-bg-2 absolute inset-0 bg-cover bg-center"
      style="background-image:url('/images/s2.webp')"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>

    <div class="max-w-page px-gutter relative z-10 mx-auto w-full">
      <div class="mb-5 flex items-center gap-3">
        <span class="bg-accent-500 block h-px w-10 shrink-0" aria-hidden="true"></span>
        <span class="text-accent-400 font-sans text-[16px] font-medium tracking-wide"
          >Peninsula Pavers, Inc.</span
        >
      </div>

      <Heading level={1} size="display" class="text-neutral-0 max-w-3xl">
        Crafted for Northern Michigan
      </Heading>

      <p class="mt-5 max-w-xl font-sans text-xl text-neutral-300">
        Paving brick, retaining walls &amp; outdoor living spaces built to last a lifetime.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="#free-estimate" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="border-neutral-0/75 text-neutral-0 hover:border-neutral-0 inline-flex items-center gap-2 border bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium no-underline hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ── STATS BAR ──────────────────────────────────────────────────────── -->
  <div class="bg-surface-brand py-section-sm w-full">
    <div class="max-w-page px-gutter mx-auto">
      <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map(({ value, label }, i) => (
            <div
              class:list={[
                'flex flex-col gap-1 text-center',
                i > 0 && 'lg:border-l-2 lg:border-l-[#ffffff33]',
              ]}
            >
              <dd class="font-heading text-neutral-0 text-4xl font-semibold">{value}</dd>
              <dt class="text-neutral-0/75 font-sans text-[20px] font-medium">{label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- ── SERVICES ───────────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col gap-10 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
            <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
              >Our Services</span
            >
          </div>
          <Heading level={2} class="text-brand-700 !text-4xl font-bold">Every Surface,</Heading>
          <Heading level={2} class="text-brand-700 !text-4xl font-medium italic"
            >Masterfully Crafted</Heading
          >
        </div>
        <p class="text-ink-muted max-w-sm font-sans text-[16px]">
          From driveways to waterscapes, Peninsula Pavers brings 30 years of Northern Michigan
          craftsmanship to every project.
        </p>
      </div>

      <ul class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map(({ label, href, image }) => (
            <li>
              <a
                href={href}
                class="group flex h-[349px] flex-col items-start justify-end overflow-hidden p-6 no-underline"
                style={`background-image:linear-gradient(#0000004d,#0000004d),url('${image}');background-size:cover;background-position:center`}
              >
                <span class="text-neutral-0 group-hover:text-accent-300 font-sans text-[16px] font-medium transition-colors">
                  {label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- ── CTA STRIP ──────────────────────────────────────────────────────── -->
  <!-- CTA strip: horizontal layout, space-between, bottom border Trans-White -->
  <div class="border-b-neutral-0/[73%] bg-surface-brand w-full border-b py-[30px]">
    <div
      class="max-w-page px-gutter mx-auto flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"
    >
      <div class="flex flex-col items-start gap-[10px]">
        <p class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase">
          Free Consultation
        </p>
        <h3 class="font-heading text-neutral-0 text-[30px] font-medium">
          Ready to Transform Your Outdoor Space?
        </h3>
        <p class="text-neutral-0/75 font-sans text-[16px]">
          Len will personally visit your property — no obligation, no cost.
        </p>
      </div>
      <div
        class="flex w-full shrink-0 flex-col items-stretch gap-[10px] sm:w-auto sm:flex-row sm:items-center"
      >
        <Button href="#free-estimate" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="border-neutral-0/75 text-neutral-0 hover:border-neutral-0 inline-flex items-center gap-2 border bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium no-underline hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </div>

  <!-- ── ABOUT ──────────────────────────────────────────────────────────── -->
  <section
    class="w-full py-[100px]"
    style="background-image:linear-gradient(#03277fba,#03277fba),url('/images/about-bg.webp');background-size:cover;background-position:center"
  >
    <div class="max-w-page px-gutter mx-auto">
      <div class="flex max-w-xl flex-col items-start gap-5">
        <div class="flex items-center gap-3">
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
          <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
            >About Peninsula Pavers</span
          >
        </div>
        <div>
          <Heading level={2} class="text-neutral-0 !text-4xl font-medium"
            >Northern Michigan's</Heading
          >
          <Heading level={3} class="text-neutral-0 !text-4xl font-medium italic"
            >Hardscaping Artisans</Heading
          >
        </div>
        <p class="text-neutral-0/75 font-sans text-[20px]">
          At Peninsula Pavers, Inc., one of our main goals is perfection. We strive for it every day
          on your projects, large or small. We take into account your visions of the design along
          with our ideas and come up with something that you the customer, and us at Peninsula
          Pavers, will love and take pride in.
        </p>
        <ul class="grid w-full gap-2 sm:grid-cols-2">
          {
            aboutBullets.map((item) => (
              <li class="text-neutral-0/75 flex items-center gap-2 font-sans text-[20px]">
                <Icon
                  name="lucide:check"
                  class="text-accent-400 size-4 shrink-0"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── OWNER ──────────────────────────────────────────────────────────── -->
  <Section background="base" spacing="md">
    <Container layout="row" gap="lg">
      <div
        class="h-[556px] w-full shrink-0 bg-contain bg-center bg-no-repeat md:w-1/2"
        style="background-image:url('/images/Team.webp')"
        role="img"
        aria-label="Len Allgaier, Owner & Designer"
      >
      </div>
      <div class="flex flex-col items-start gap-5 md:order-2 md:w-1/2">
        <div class="flex items-center gap-3">
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
          <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
            >Meet The Owner</span
          >
        </div>
        <div>
          <Heading level={2} class="text-brand-700 !text-4xl font-bold">Len Allgaier</Heading>
          <Heading level={3} class="text-brand-700 !text-4xl font-medium italic"
            >Owner &amp; Designer</Heading
          >
        </div>
        <p class="text-ink-muted font-sans">
          Len is owner-operator and designer of Peninsula Pavers, who relocated from the Detroit
          area after college in pursuit of doing something he loves, in a location he truly wanted
          to live. He started the business in 1994 with just a few small trucks and has grown to be
          very in demand with handpicked craftsmen to facilitate his vision.
        </p>
        <p class="text-ink-muted font-sans">
          Len personally completes every complimentary consultation and works with the home or
          business owner to create a design that is exactly what they are dreaming of. There is no
          better feeling leaving a job knowing that the customer is 100% satisfied.
        </p>
        <blockquote
          class="border-accent-500 text-ink-muted border-l-2 pl-4 font-sans text-[16px] italic"
        >
          &ldquo;We build trust and friendships with every project we complete.&rdquo;
        </blockquote>
      </div>
    </Container>
  </Section>

  <!-- ── PROCESS ────────────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col items-center gap-3 text-center">
        <div class="flex items-center gap-3">
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
          <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
            >How It Works</span
          >
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
        </div>
        <Heading level={2} class="text-brand-700 !text-4xl font-bold">Our Process</Heading>
      </div>
      <ol class="grid w-full gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              num: '01',
              title: 'Complimentary Consultation',
              body: 'Len personally visits your property, listens to your vision, and provides expert design suggestions — at no cost.',
            },
            {
              num: '02',
              title: 'Written Estimate',
              body: 'Receive a detailed written estimate. Any changes or additions are presented in a separate estimate and require your approval.',
            },
            {
              num: '03',
              title: 'Scheduled Build',
              body: 'Once approved and deposit received, your project is added to our schedule. You receive an estimated start date.',
            },
            {
              num: '04',
              title: 'Exceptional Delivery',
              body: "Our handpicked local craftsmen complete your project to our rigid standards. We don't leave until you're 100% satisfied.",
            },
          ].map(({ num, title, body }) => (
            <li class="flex flex-col gap-3">
              <span
                class="font-heading text-brand-700/30 text-[72px] leading-none font-medium"
                aria-hidden="true"
              >
                {num}
              </span>
              <span class="bg-accent-500 block h-px w-10" aria-hidden="true" />
              <h3 class="font-heading text-brand-700 text-[20px] font-medium">{title}</h3>
              <p class="text-ink-muted font-sans text-[16px]">{body}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────── -->
  <TestimonialsCarousel items={testimonials} />
</BaseLayout>

<style>
  /* Hero crossfade: s2.webp fades in over s1.webp on a 10s loop */
  .hero-bg-2 {
    animation: hero-crossfade 10s 5s infinite;
    opacity: 0;
  }
  @keyframes hero-crossfade {
    0% {
      opacity: 0;
    }
    10%,
    45% {
      opacity: 1;
    }
    55%,
    90% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-2 {
      animation: none;
    }
  }
</style>
