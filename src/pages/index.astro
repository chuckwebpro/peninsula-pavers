---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';

const services = [
  { label: 'Outdoor Living Spaces', href: '/services/outdoor-living-spaces/', image: '/images/backyard-hardscaping.webp' },
  { label: 'Custom Patios',         href: '/services/patios/',                 image: '/images/custom-patio-construction.webp' },
  { label: 'Paver Driveways',       href: '/services/driveways/',              image: '/images/driveway-with-pavers.webp' },
  { label: 'Retaining Walls',       href: '/services/retaining-walls/',        image: '/images/retaining-wall-construction.jpg' },
  { label: 'Stone Walkways',        href: '/services/walkways/',        image: '/images/custom-stone-walkway.webp' },
  { label: 'Waterscapes',           href: '/services/waterscapes/',            image: '/images/frontyard-waterscape.jpg' },
];

const stats = [
  { value: '30+',  label: 'Years In Business' },
  { value: '12',   label: 'Counties Served' },
  { value: '100%', label: 'Satisfaction Guaranteed' },
  { value: '1994', label: 'Est. In Traverse City' },
];

const aboutBullets = [
  'BBB Accredited Business',
  'Natural Stone & Man-Made Materials',
  'Residential & Commercial',
  'Serving Northern Michigan Since 1994',
];
---

<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description} pageType="home" sticky="overlay">

  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section class="relative flex min-h-screen items-end pb-16 pt-32" aria-label="Hero">
    <div class="hero-bg absolute inset-0 bg-brand-900 bg-cover bg-center"
      style="background-image:url('/images/s1.webp')" aria-hidden="true"></div>
    <div class="hero-bg hero-bg-2 absolute inset-0 bg-cover bg-center"
      style="background-image:url('/images/s2.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto w-full max-w-page px-gutter">
      <div class="mb-5 flex items-center gap-3">
        <span class="block h-px w-10 shrink-0 bg-accent-500" aria-hidden="true"></span>
        <span class="font-sans text-[16px] font-medium tracking-wide text-accent-400">Peninsula Pavers, Inc.</span>
      </div>

      <Heading level={1} size="display" class="max-w-3xl text-neutral-0">
        Crafted for Northern Michigan
      </Heading>

      <p class="mt-5 max-w-xl font-sans text-xl text-neutral-300">
        Paving brick, retaining walls &amp; outdoor living spaces built to last a lifetime.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/#contact" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="inline-flex items-center gap-2 border border-neutral-0/75 bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium text-neutral-0 no-underline hover:border-neutral-0 hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ── STATS BAR ──────────────────────────────────────────────────────── -->
  <div class="w-full bg-surface-brand py-section-sm">
    <div class="mx-auto max-w-page px-gutter">
      <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map(({ value, label }, i) => (
          <div class:list={['flex flex-col gap-1 text-center', i > 0 && 'lg:border-l-2 lg:border-l-[#ffffff33]']}>
            <dd class="font-heading text-4xl font-semibold text-neutral-0">{value}</dd>
            <dt class="font-sans text-[20px] font-medium text-neutral-0/75">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- ── SERVICES ───────────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col gap-10 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
            <span class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">Our Services</span>
          </div>
          <Heading level={2} class="!text-4xl font-bold text-brand-700">Every Surface,</Heading>
          <Heading level={2} class="!text-4xl font-medium italic text-brand-700">Masterfully Crafted</Heading>
        </div>
        <p class="max-w-sm font-sans text-[16px] text-ink-muted">
          From driveways to waterscapes, Peninsula Pavers brings 30 years of Northern Michigan
          craftsmanship to every project.
        </p>
      </div>

      <ul class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map(({ label, href, image }) => (
          <li>
            <a
              href={href}
              class="group flex h-[349px] flex-col items-start justify-end overflow-hidden p-6 no-underline"
              style={`background-image:linear-gradient(#0000004d,#0000004d),url('${image}');background-size:cover;background-position:center`}
            >
              <span class="font-sans text-[16px] font-medium text-neutral-0 transition-colors group-hover:text-accent-300">
                {label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <!-- ── CTA STRIP ──────────────────────────────────────────────────────── -->
  <!-- CTA strip: horizontal layout, space-between, bottom border Trans-White -->
  <div class="w-full border-b border-b-neutral-0/[73%] bg-surface-brand py-[30px]">
    <div class="mx-auto flex max-w-page flex-col items-start justify-between gap-6 px-gutter md:flex-row md:items-center">
      <div class="flex flex-col gap-[10px] items-start">
        <p class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">Free Consultation</p>
        <h3 class="font-heading text-[30px] font-medium text-neutral-0">Ready to Transform Your Outdoor Space?</h3>
        <p class="font-sans text-[16px] text-neutral-0/75">Len will personally visit your property — no obligation, no cost.</p>
      </div>
      <div class="flex w-full shrink-0 flex-col items-stretch gap-[10px] sm:w-auto sm:flex-row sm:items-center">
        <Button href="/#contact" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="inline-flex items-center gap-2 border border-neutral-0/75 bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium text-neutral-0 no-underline hover:border-neutral-0 hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </div>

  <!-- ── ABOUT ──────────────────────────────────────────────────────────── -->
  <section
    class="w-full py-[100px]"
    style="background-image:linear-gradient(#03277fba,#03277fba),url('/images/about-bg.webp');background-size:cover;background-position:center"
  >
    <div class="mx-auto max-w-page px-gutter">
      <div class="flex max-w-xl flex-col items-start gap-5">
        <div class="flex items-center gap-3">
          <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
          <span class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">About Peninsula Pavers</span>
        </div>
        <div>
          <Heading level={2} class="!text-4xl font-medium text-neutral-0">Northern Michigan's</Heading>
          <Heading level={3} class="!text-4xl font-medium italic text-neutral-0">Hardscaping Artisans</Heading>
        </div>
        <p class="font-sans text-[20px] text-neutral-0/75">
          At Peninsula Pavers, Inc., one of our main goals is perfection. We strive for it every
          day on your projects, large or small. We take into account your visions of the design
          along with our ideas and come up with something that you the customer, and us at
          Peninsula Pavers, will love and take pride in.
        </p>
        <ul class="grid w-full gap-2 sm:grid-cols-2">
          {aboutBullets.map((item) => (
            <li class="flex items-center gap-2 font-sans text-[20px] text-neutral-0/75">
              <Icon name="lucide:check" class="size-4 shrink-0 text-accent-400" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── OWNER ──────────────────────────────────────────────────────────── -->
  <Section background="base" spacing="md">
    <Container layout="row" gap="lg">
      <div
        class="w-full shrink-0 md:w-1/2 h-[556px] bg-no-repeat bg-contain bg-center"
        style="background-image:url('/images/Team.webp')"
        role="img"
        aria-label="Len Allgaier, Owner &amp; Designer"
      ></div>
      <div class="flex flex-col items-start gap-5 md:order-2 md:w-1/2">
        <div class="flex items-center gap-3">
          <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
          <span class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">Meet The Owner</span>
        </div>
        <div>
          <Heading level={2} class="!text-4xl font-bold text-brand-700">Len Allgaier</Heading>
          <Heading level={3} class="!text-4xl font-medium italic text-brand-700">Owner &amp; Designer</Heading>
        </div>
        <p class="font-sans text-ink-muted">
          Len is owner-operator and designer of Peninsula Pavers, who relocated from the Detroit
          area after college in pursuit of doing something he loves, in a location he truly wanted
          to live. He started the business in 1994 with just a few small trucks and has grown to
          be very in demand with handpicked craftsmen to facilitate his vision.
        </p>
        <p class="font-sans text-ink-muted">
          Len personally completes every complimentary consultation and works with the home or
          business owner to create a design that is exactly what they are dreaming of. There is no
          better feeling leaving a job knowing that the customer is 100% satisfied.
        </p>
        <blockquote class="border-l-2 border-accent-500 pl-4 font-sans text-[16px] italic text-ink-muted">
          &ldquo;We build trust and friendships with every project we complete.&rdquo;
        </blockquote>
      </div>
    </Container>
  </Section>

  <!-- ── PROCESS ────────────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col items-center gap-3 text-center">
        <div class="flex items-center gap-3">
          <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
          <span class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">How It Works</span>
          <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
        </div>
        <Heading level={2} class="!text-4xl font-bold text-brand-700">Our Process</Heading>
      </div>
      <ol class="grid w-full gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { num: '01', title: 'Complimentary Consultation', body: 'Len personally visits your property, listens to your vision, and provides expert design suggestions — at no cost.' },
          { num: '02', title: 'Written Estimate',           body: 'Receive a detailed written estimate. Any changes or additions are presented in a separate estimate and require your approval.' },
          { num: '03', title: 'Scheduled Build',            body: 'Once approved and deposit received, your project is added to our schedule. You receive an estimated start date.' },
          { num: '04', title: 'Exceptional Delivery',       body: "Our handpicked local craftsmen complete your project to our rigid standards. We don't leave until you're 100% satisfied." },
        ].map(({ num, title, body }) => (
          <li class="flex flex-col gap-3">
            <span class="font-heading text-[72px] font-medium leading-none text-brand-700/30" aria-hidden="true">{num}</span>
            <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
            <h3 class="font-heading text-[20px] font-medium text-brand-700">{title}</h3>
            <p class="font-sans text-[16px] text-ink-muted">{body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────── -->
  <section class="w-full bg-surface-brand py-[50px]">
    <div class="mx-auto flex max-w-page flex-col items-center gap-5 px-gutter text-center">
      <div class="flex items-center gap-3">
        <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
        <span class="font-sans text-[16px] font-medium uppercase tracking-[2px] text-accent-500">Client Stories</span>
        <span class="block h-px w-10 bg-accent-500" aria-hidden="true"></span>
      </div>
      <Heading level={2} class="!text-4xl font-bold text-neutral-0">What Our Clients Say</Heading>
      <p class="max-w-lg font-sans text-[20px] font-medium text-neutral-0/75">
        Trusted by homeowners and businesses across Northern Michigan for over 30 years.
      </p>
    </div>

    <div class="t-carousel relative mx-auto mt-[50px] max-w-[1380px] px-12">
      <div class="t-window overflow-hidden">
        <ul class="t-track flex" style="will-change:transform">
          {[
            { quote: 'I have worked with Peninsula Pavers and the experience was WONDERFUL! They exceeded all of my needs; their design and creativity is amazing. Thank you for making my landscape an envy to my neighbors!', name: 'Dawn Hartley',     role: 'Homeowner' },
            { quote: 'Len and his company come with creativity, reliability and a commitment to detail — no matter the size of the project. Len has the vision and insight of not only what works, but what looks right and is aesthetically pleasing.',  name: 'Kelly E. Miller', role: 'Homeowner' },
            { quote: "Three years later and my driveway always looks amazing. Lenny said it would be great and he's right!",                                                                                                                              name: 'Maggie Smith Kent', role: 'Homeowner' },
            { quote: 'I have worked with Peninsula Pavers and the experience was WONDERFUL! They exceeded all of my needs; their design and creativity is amazing. Thank you for making my landscape an envy to my neighbors!', name: 'Dawn Hartley',     role: 'Homeowner' },
            { quote: 'Len and his company come with creativity, reliability and a commitment to detail — no matter the size of the project. Len has the vision and insight of not only what works, but what looks right and is aesthetically pleasing.',  name: 'Kelly E. Miller', role: 'Homeowner' },
            { quote: "Three years later and my driveway always looks amazing. Lenny said it would be great and he's right!",                                                                                                                              name: 'Maggie Smith Kent', role: 'Homeowner' },
          ].map(({ quote, name, role }) => (
            <li class="t-slide">
              <div class="flex h-full flex-col gap-4 border border-[#ffffff1c] bg-[#ffffff0d] p-5">
              <span class="font-heading text-3xl leading-none text-accent-500" aria-hidden="true">&ldquo;</span>
              <div class="flex gap-0.5" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="size-4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="var(--color-accent-500)" stroke="none"/></svg>
                ))}
              </div>
              <p class="flex-1 font-sans text-[16px] italic text-neutral-0/75">{quote}</p>
              <footer>
                <p class="font-sans text-[16px] font-medium text-neutral-0">{name}</p>
                <p class="font-sans text-[16px] uppercase tracking-[2px] text-accent-500">{role}</p>
              </footer>
            </div>
            </li>
          ))}
        </ul>
      </div>

      <button class="t-prev absolute left-0 top-1/2 -translate-y-1/2 flex items-center justify-center p-2 text-neutral-0" aria-label="Previous">
        <Icon name="lucide:chevron-left" class="size-6" aria-hidden="true" />
      </button>
      <button class="t-next absolute right-0 top-1/2 -translate-y-1/2 flex items-center justify-center p-2 text-neutral-0" aria-label="Next">
        <Icon name="lucide:chevron-right" class="size-6" aria-hidden="true" />
      </button>

      <div class="t-dots mt-6 flex justify-center gap-2"></div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero crossfade: s2.webp fades in over s1.webp on a 10s loop */
  .hero-bg-2 {
    animation: hero-crossfade 10s 5s infinite;
    opacity: 0;
  }
  @keyframes hero-crossfade {
    0%       { opacity: 0; }
    10%, 45% { opacity: 1; }
    55%, 90% { opacity: 0; }
    100%     { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-2 { animation: none; }
  }

  /* Testimonial slide widths — JS reads perView from CSS */
  .t-slide { flex-shrink: 0; width: 33.333%; padding: 0 10px; box-sizing: border-box; }
  @media (max-width: 1023px) { .t-slide { width: 50%; } }
  @media (max-width: 767px)  { .t-slide { width: 100%; } }

  .t-track { transition: transform 500ms ease; }

  /* Pagination dots */
  .t-dots button {
    width: 12px; height: 12px; border-radius: 50%;
    background: #fff; opacity: 0.5; border: none; cursor: pointer;
    transition: opacity 150ms, background 150ms;
    padding: 0;
  }
  .t-dots button.active {
    background: var(--color-accent-500);
    opacity: 1;
  }
</style>

<script is:inline>
  (function () {
    var carousel = document.querySelector('.t-carousel');
    if (!carousel) return;
    var track  = carousel.querySelector('.t-track');
    var slides = Array.from(carousel.querySelectorAll('.t-slide'));
    var prevBtn = carousel.querySelector('.t-prev');
    var nextBtn = carousel.querySelector('.t-next');
    var dotsEl  = carousel.querySelector('.t-dots');
    var idx = 0, timer;
    var UNIQUE = 3; /* real testimonial count — slides are doubled for loop */

    function perView() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768)  return 2;
      return 1;
    }

    function goTo(i) {
      var pv  = perView();
      var max = slides.length - pv; /* 6-3=3 on desktop */
      idx = i;
      if (idx < 0)   idx = max;
      if (idx > max) idx = 0;
      track.style.transform = 'translateX(-' + (idx * (100 / pv)) + '%)';
      dotsEl.querySelectorAll('button').forEach(function (d, j) {
        d.classList.toggle('active', j === (idx % UNIQUE));
      });
    }

    /* build dots (one per unique testimonial) */
    for (var i = 0; i < UNIQUE; i++) {
      (function(n) {
        var btn = document.createElement('button');
        btn.setAttribute('aria-label', 'Go to slide ' + (n + 1));
        btn.addEventListener('click', function () { goTo(n); });
        dotsEl.appendChild(btn);
      }(i));
    }

    prevBtn.addEventListener('click', function () { clearInterval(timer); goTo(idx - 1); startTimer(); });
    nextBtn.addEventListener('click', function () { clearInterval(timer); goTo(idx + 1); startTimer(); });

    function startTimer() {
      timer = setInterval(function () { goTo(idx + 1); }, 5000);
    }
    carousel.addEventListener('mouseenter', function () { clearInterval(timer); });
    carousel.addEventListener('mouseleave', startTimer);
    window.addEventListener('resize', function () { goTo(idx); });

    goTo(0);
    startTimer();
  }());
</script>

