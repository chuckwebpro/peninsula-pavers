---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';

const steps = [
  {
    number: '01',
    title: 'We review your request',
    body: 'Our team reads your message and prepares for your free consultation.',
  },
  {
    number: '02',
    title: "We'll be in touch",
    body: 'Expect a call or email the same business day — usually within a few hours.',
  },
  {
    number: '03',
    title: 'Free on-site estimate',
    body: 'We visit your property and walk you through a detailed written quote, no obligation.',
  },
];
---

<BaseLayout
  title={`Thank You | ${site.name}`}
  description="We've received your message."
  noindex
  sticky="overlay"
>
  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section
    class="relative flex min-h-[750px] items-center overflow-hidden"
    aria-label="Confirmation"
  >
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image:linear-gradient(rgba(0,0,0,0.502),rgba(0,0,0,0.502)),url('/images/s1.webp')"
      aria-hidden="true"
    >
    </div>

    <div class="max-w-page px-gutter relative z-10 mx-auto w-full pt-[100px]">
      <div class="mb-5 flex items-center gap-3">
        <Icon name="lucide:circle-check" class="text-accent-400 size-6" aria-hidden="true" />
        <span class="text-accent-400 font-sans text-[16px] font-medium tracking-wide"
          >Message received</span
        >
      </div>

      <Heading level={1} class="text-neutral-0 max-w-3xl !text-[56px] font-medium">
        Thanks &mdash; we&rsquo;ve got it
      </Heading>

      <p class="text-neutral-0/75 mt-4 max-w-xl font-sans text-[20px]">
        Your message is on its way to our team. We usually reply the same business day. If
        it&rsquo;s urgent, calling is faster.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <Button href="/" size="lg">Back to home</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="border-neutral-0/75 text-neutral-0 hover:border-neutral-0 inline-flex items-center gap-2 border bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium no-underline hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHAT HAPPENS NEXT ─────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container align="center" gap="lg">
      <div class="flex items-center gap-4">
        <span class="bg-accent-500 block h-px w-10 shrink-0" aria-hidden="true"></span>
        <span class="text-ink-muted font-sans text-[16px] font-semibold tracking-wide uppercase"
          >What Happens Next</span
        >
        <span class="bg-accent-500 block h-px w-10 shrink-0" aria-hidden="true"></span>
      </div>

      <Heading level={2} size="xl">Here&rsquo;s what to expect</Heading>

      <div class="grid w-full gap-6 sm:grid-cols-3">
        {
          steps.map((step) => (
            <div class="bg-surface-base flex flex-col gap-3 rounded-lg p-8 shadow-sm">
              <span class="text-accent-500 font-sans text-[42px] leading-none font-semibold">
                {step.number}
              </span>
              <Heading level={3} size="md">
                {step.title}
              </Heading>
              <p class="text-ink-muted font-sans text-[16px]">{step.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>
</BaseLayout>
