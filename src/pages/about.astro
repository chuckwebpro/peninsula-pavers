---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import Gallery from '../components/ui/Gallery.astro';
import aboutImg1 from '../assets/images/walkway-1.jpg';
import aboutImg2 from '../assets/images/IMG_1450.jpg';
import aboutImg3 from '../assets/images/waterscape-1.jpg';
import aboutImg4 from '../assets/images/retaining-wall-feature.jpg';
import aboutImg5 from '../assets/images/warm-pond.jpg';
import aboutImg6 from '../assets/images/IMG_1164.webp';

const galleryImages = [
  { src: aboutImg1, alt: 'Custom stone walkway' },
  { src: aboutImg2, alt: 'Custom paver patio' },
  { src: aboutImg3, alt: 'Waterfall and pond' },
  { src: aboutImg4, alt: 'Retaining wall' },
  { src: aboutImg5, alt: 'Landscaping and pond' },
  { src: aboutImg6, alt: 'Outdoor hardscaping' },
];

const faqs = [
  {
    q: 'What does an outdoor living space cost in Traverse City?',
    a: "Every relationship and every project is unique, so we don't publish a price range that would be wrong for most people who read it. Cost depends on square footage, material selection, site conditions, grade, drainage needs, and features like fireplaces, kitchens, or lighting. After we see your space, you get a detailed written quote with no obligation, and that price is locked for 30 days.",
  },
  {
    q: 'How long does an outdoor living space project take?',
    a: "It depends on scope and weather, and we won't pretend otherwise. A straightforward patio and seating area moves faster than a full outdoor kitchen with a fireplace and integrated lighting. What we will do is give you a specific timeline in writing during your free consultation, before you commit to anything, and tell you right away if weather is going to shift it.",
  },
  {
    q: 'How long will your crew be on my property?',
    a: "We give you the on-site window in your written estimate, and we hold to it unless weather forces a change. When that happens, you hear it from us the same day. We keep the work area clean and safe the entire time, because you still have to live there while we're working.",
  },
];
---

<BaseLayout
  title={`About Us | ${site.name}`}
  description="Peninsula Pavers has built patios, driveways, retaining walls, and outdoor living spaces across Traverse City for more than 25 years. Owner-designed, locally owned."
  pageType="about"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about/' },
  ]}
  sticky="overlay"
>
  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section class="relative flex min-h-[750px] items-center overflow-hidden" aria-label="Page hero">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image:linear-gradient(rgba(0,0,0,0.502),rgba(0,0,0,0.502)),url('/images/s1.webp')"
      aria-hidden="true"
    >
    </div>

    <div class="max-w-page px-gutter relative z-10 mx-auto w-full pt-[140px] md:pt-[100px]">
      <div class="mb-5 flex items-center gap-3">
        <span class="bg-accent-500 block h-px w-10 shrink-0" aria-hidden="true"></span>
        <span class="text-accent-400 font-sans text-[16px] font-medium tracking-wide"
          >Peninsula Pavers, Inc.</span
        >
      </div>

      <Heading level={1} class="text-neutral-0 max-w-3xl !text-[36px] font-medium md:!text-[56px]">
        About Peninsula Pavers<br />in Traverse City, MI
      </Heading>

      <p class="text-neutral-0/75 mt-4 max-w-[900px] font-sans text-[20px] font-medium">
        Peninsula Pavers has built patios, driveways, walls, and outdoor living spaces across
        Traverse City for more than 25 years. Owner-designed, locally owned.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <Button href="#free-estimate" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="border-neutral-0/75 text-neutral-0 hover:border-neutral-0 inline-flex items-center gap-2 border bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium no-underline hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT FEATURE ─────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col gap-10 md:flex-row md:items-center md:gap-10">
        <div class="relative shrink-0 md:w-[50%]">
          <div
            class="border-accent-500 absolute right-[-12px] bottom-[-12px] hidden size-24 border md:block"
            aria-hidden="true"
          >
          </div>
          <img
            src="/images/patio-2.jpg"
            alt="Peninsula Pavers custom hardscaping project"
            width="688"
            height="516"
            class="relative z-[2] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="flex flex-col gap-3 md:w-[50%]">
          <div class="flex items-center gap-3">
            <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
            <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
              >About Peninsula Pavers</span
            >
          </div>
          <Heading level={2} class="text-brand-700 !text-4xl font-bold">25 Years Building</Heading>
          <Heading level={2} class="text-brand-700 !text-4xl font-medium italic"
            >What Lasts in Northern Michigan</Heading
          >
          <p class="text-ink-muted font-sans text-[16px]">
            Peninsula Pavers has been building outdoor spaces in Traverse City for more than 25
            years. Owner and designer Len Allgaier leads every project, which means the person who
            draws your design is the person accountable for how it gets built. We are locally owned
            and we work in this region because we know it.
          </p>
          <p class="text-ink-muted font-sans text-[16px]">
            Michigan freeze and thaw cycles, Leelanau slopes, waterfront soil conditions, the way a
            February plow season treats a driveway. That knowledge shows up in base depths, drainage
            details, and material choices that do not fail in year four.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ── MID-PAGE CTA STRIP ─────────────────────────────────────────────── -->
  <div class="bg-surface-brand w-full py-[30px]">
    <div
      class="max-w-page px-gutter mx-auto flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"
    >
      <div class="flex flex-col items-start gap-[10px]">
        <p class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase">
          Free Consultation
        </p>
        <h2 class="font-heading text-neutral-0 text-[30px] font-medium">
          Ready to Transform Your Outdoor Space?
        </h2>
        <p class="text-neutral-0/75 font-sans text-[16px]">
          Len will personally visit your property — no obligation, no cost.
        </p>
      </div>
      <div
        class="flex w-full shrink-0 flex-col items-stretch gap-[10px] sm:w-auto sm:flex-row sm:items-center"
      >
        <Button href="#free-estimate" size="lg">Free Estimate</Button>
        <a
          href={`tel:${site.business.phoneHref}`}
          class="border-neutral-0/75 text-neutral-0 hover:border-neutral-0 inline-flex items-center gap-2 border bg-transparent px-[25px] py-[12px] font-sans text-[20px] font-medium no-underline hover:bg-white/10"
        >
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.business.phone}
        </a>
      </div>
    </div>
  </div>

  <!-- ── WHAT WE BUILD ─────────────────────────────────────────────────── -->
  <Section background="muted" spacing="md">
    <Container gap="lg">
      <div class="flex w-full flex-col gap-10 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
            <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
              >What We Build</span
            >
          </div>
          <Heading level={2} class="text-brand-700 !text-4xl font-bold">The Outdoor Spaces</Heading>
          <Heading level={2} class="text-brand-700 !text-4xl font-medium italic"
            >We can Help Create</Heading
          >
        </div>
        <p class="text-ink-muted max-w-sm font-sans text-[16px] md:text-end">
          Patios, paver driveways, retaining walls, walkways and sidewalks, waterscapes, full
          outdoor living spaces, and complete landscape design, using natural stone, pavers, and
          materials selected for how they perform here.
        </p>
      </div>

      <Gallery images={galleryImages} />
    </Container>
  </Section>

  <!-- ── FAQ ────────────────────────────────────────────────────────────── -->
  <section class="bg-surface-brand py-section w-full" aria-labelledby="faq-heading">
    <div class="px-gutter mx-auto flex max-w-[1380px] flex-col items-center gap-8">
      <div class="flex flex-col items-center gap-4 text-center">
        <div class="flex items-center gap-4">
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
          <span class="text-accent-500 font-sans text-[16px] font-medium tracking-[2px] uppercase"
            >Frequently Asked Questions</span
          >
          <span class="bg-accent-500 block h-px w-10" aria-hidden="true"></span>
        </div>
        <Heading id="faq-heading" level={2} class="text-neutral-0 !text-4xl font-bold">
          We Can Answer All Your Questions
        </Heading>
      </div>

      <div class="flex w-full flex-wrap justify-center gap-5">
        {
          faqs.map((faq) => (
            <div class="flex w-full flex-col gap-5 bg-white/[0.08] p-[30px] sm:w-[calc(50%-10px)] lg:w-[32%]">
              <div class="flex items-start gap-3">
                <svg
                  aria-hidden="true"
                  class="text-accent-400 mt-1 size-5 shrink-0"
                  viewBox="0 0 512 512"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                >
                  <path d="M256 8C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm0 448c-110.532 0-200-89.431-200-200 0-110.495 89.472-200 200-200 110.491 0 200 89.471 200 200 0 110.53-89.431 200-200 200zm107.244-255.2c0 67.052-72.421 68.084-72.421 92.863V300c0 6.627-5.373 12-12 12h-45.647c-6.627 0-12-5.373-12-12v-8.659c0-35.745 27.1-50.034 47.579-61.516 17.561-9.845 28.324-16.541 28.324-29.579 0-17.246-21.999-28.693-39.784-28.693-23.189 0-33.894 10.977-48.942 29.969-4.057 5.12-11.46 6.071-16.666 2.124l-27.824-21.098c-5.107-3.872-6.251-11.066-2.644-16.363C184.846 131.491 214.94 112 261.794 112c49.071 0 101.45 38.304 101.45 88.8zM298 368c0 23.159-18.841 42-42 42s-42-18.841-42-42 18.841-42 42-42 42 18.841 42 42z" />
                </svg>
                <h3 class="font-heading text-neutral-0 text-xl font-medium">{faq.q}</h3>
              </div>
              <p class="text-neutral-0/75 font-sans text-[16px] font-medium">{faq.a}</p>
            </div>
          ))
        }
      </div>

      <p class="text-neutral-0/75 font-sans text-[16px]">
        Still have questions? <a
          href={`tel:${site.business.phoneHref}`}
          class="text-accent-400 no-underline hover:underline">Call us today!</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
